; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="مدار"
config/version="1.0.0"
run/main_scene="res://core/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/brand/icon_192.png"

[autoload]

Log="*res://core/log.gd"
SaveService="*res://core/save_service.gd"
Settings="*res://core/settings.gd"
Progress="*res://core/progress.gd"
Catalog="*res://core/catalog.gd"
Sfx="*res://core/sfx.gd"
Music="*res://core/music.gd"
Router="*res://core/router.gd"
Quality="*res://core/quality.gd"
Perf="*res://core/perf.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1560
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.054902, 0.0784314, 0.141176, 1)
